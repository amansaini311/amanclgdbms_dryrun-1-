@app.route('/api/students', methods=['GET'])
def get_students():
    conn = get_db()
    cursor = conn.cursor(dictionary=True)
    cursor.execute("SELECT * FROM students")
    rows = cursor.fetchall()
    cursor.close(); conn.close()
    return jsonify(rows)

@app.route('/api/students', methods=['POST'])
def add_student():
    d = request.json
    conn = get_db()
    cursor = conn.cursor()
    try:
        cursor.execute(
            "INSERT INTO students (name, department, rollnumber, year, email) VALUES (%s,%s,%s,%s,%s)",
            (d['name'], d['department'], d['rollnumber'], d['year'], d['email'])
        )
        conn.commit()
        new_id = cursor.lastrowid
        cursor.close(); conn.close()
        return jsonify({"success": True, "student_id": new_id})
    except mysql.connector.IntegrityError:
        cursor.close(); conn.close()
        return jsonify({"success": False, "message": "Roll number already exists"}), 409

@app.route('/api/students/<int:sid>', methods=['PUT'])
def update_student(sid):
    d = request.json
    conn = get_db()
    cursor = conn.cursor()
    try:
        cursor.execute(
            "UPDATE students SET name=%s, department=%s, rollnumber=%s, year=%s, email=%s WHERE student_id=%s",
            (d['name'], d['department'], d['rollnumber'], d['year'], d['email'], sid)
        )
        conn.commit()
        cursor.close(); conn.close()
        return jsonify({"success": True})
    except mysql.connector.IntegrityError:
        cursor.close(); conn.close()
        return jsonify({"success": False, "message": "Roll number already in use"}), 409

@app.route('/api/students/<int:sid>', methods=['DELETE'])
def delete_student(sid):
    conn = get_db()
    cursor = conn.cursor()
    cursor.execute("DELETE FROM students WHERE student_id=%s", (sid,))
    conn.commit()
    cursor.close(); conn.close()
    return jsonify({"success": True})

